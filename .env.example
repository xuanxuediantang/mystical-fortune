# =================== AI 服务配置 ===================
# Groq API Key (免费额度)
# 获取地址: https://console.groq.com/
# 如果不填写，将使用模拟解读（演示用）
NEXT_PUBLIC_GROQ_API_KEY=

# =================== 虎皮椒支付配置 ===================
# 申请地址: https://pay.xunhuweb.com/
# 个人可用，无需营业执照
# 
# 公开配置（前端可见）- appid 可以在前端使用
NEXT_PUBLIC_XUNHU_APPID=

# 私密配置（仅服务端）- appsecret 绝对不能暴露到前端
XUNHU_APPSECRET=

# 支付回调地址（部署后填写）
# 必须是公网可访问的域名
NEXT_PUBLIC_NOTIFY_URL=https://your-domain.com/api/payment/notify